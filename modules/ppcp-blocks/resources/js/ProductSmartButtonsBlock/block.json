{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "woocommerce-paypal-payments/product-smart-buttons",
	"title": "Single Product - PayPal buttons",
	"category": "woocommerce",
	"description": "PayPal Smart Buttons shown on the single product page so eligible customers can check out directly.",
	"example": {},
	"attributes": {
		"blockId": {
			"type": "string",
			"default": "woocommerce-paypal-payments/product-smart-buttons"
		},
		"lock": {
			"type": "object",
			"default": {
				"remove": true,
				"move": false
			}
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"multiple": false
	},
	"textdomain": "woocommerce-paypal-payments",
	"editorScript": "ppcp-product-smart-buttons-block"
}
