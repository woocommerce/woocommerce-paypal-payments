{
	"root": true,
	"extends": [
		"plugin:@wordpress/eslint-plugin/recommended"
	],
	"rules": {
		"@wordpress/dependency-group": "error",
		"@wordpress/no-unsafe-wp-apis": "off",
		"no-console": "off"
	},
	"overrides": [
		{
			"files": ["*.ts", "*.tsx"],
			"parser": "@typescript-eslint/parser",
			"parserOptions": {
			"ecmaVersion": "latest",
			"sourceType": "module"
			}
		}
	]
}