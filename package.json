{
  "name": "woocommerce-paypal-payments",
  "version": "4.1.1",
  "description": "WooCommerce PayPal Payments",
  "repository": "https://github.com/woocommerce/woocommerce-paypal-payments",
  "license": "GPL-2.0",
  "author": "WooCommerce",
  "scripts": {
    "ddev:setup": "ddev start && ddev orchestrate",
    "ddev:reset": "ddev orchestrate -f",
    "ddev:install": "ddev composer install && ddev npm ci && ddev npm run build",
    "lint-js": "wp-scripts lint-js",
    "test:unit-js": "wp-scripts test-unit-js --config ./tests/js/jest.config.json",
    "test:unit-js:coverage": "wp-scripts test-unit-js --config ./tests/js/jest.config.json --coverage",
    "composer-update": "composer update && composer update --lock",
    "unit-tests": "vendor/bin/phpunit",
    "ddev:unit-tests:coverage": "ddev xdebug on && ddev exec XDEBUG_MODE=coverage phpunit --coverage-html coverage/ --coverage-clover coverage/report.xml",
    "integration-tests": "(cp -n .env.integration.example .env.integration || true) && php tests/integration/PHPUnit/setup.php && vendor/bin/phpunit -c tests/integration/phpunit.xml.dist",
    "test": "npm run unit-tests && npm run integration-tests",
    "tdd": "sh -c 'vendor/bin/phpunit --stop-on-failure -v ${1:+--filter $@}' --",
    "tdd:integration": "sh -c 'vendor/bin/phpunit -c tests/integration/phpunit.xml.dist --stop-on-failure -v ${1:+--filter $@}' --",
    "lint": "npm run phpcs && npm run phpstan",
    "phpcs": "vendor/bin/phpcs --parallel=8 -s --runtime-set ignore_warnings_on_exit 1",
    "phpstan": "vendor/bin/phpstan analyze --memory-limit=2G",
    "fix-lint": "vendor/bin/phpcbf",
    "build": "wp-scripts build",
    "watch-js": "wp-scripts start",

    "e2e:setup:tests": "npm install && npx playwright install",

    "e2e:test:shard:plugin-foundation": "npx playwright test --project \"shard:plugin-foundation\"",
    "e2e:test:shard:plugin-foundation:smoke": "npx playwright test --project \"shard:plugin-foundation\" --grep \"@Smoke\"",
    "e2e:test:shard:plugin-foundation:critical": "npx playwright test --project \"shard:plugin-foundation\" --grep \"@Critical\"",

    "e2e:test:shard:onboarding": "npx playwright test --project \"shard:onboarding\"",
    "e2e:test:shard:onboarding:smoke": "npx playwright test --project \"shard:onboarding\" --grep \"@Smoke\"",
    "e2e:test:shard:onboarding:critical": "npx playwright test --project \"shard:onboarding\" --grep \"@Critical\"",

    "e2e:test:shard:settings": "npx playwright test --project \"shard:settings\"",
    "e2e:test:shard:settings:smoke": "npx playwright test --project \"shard:settings\" --grep \"@Smoke\"",
    "e2e:test:shard:settings:critical": "npx playwright test --project \"shard:settings\" --grep \"@Critical\"",

    "e2e:test:shard:transaction-usa": "npx playwright test --project \"shard:transaction-usa\"",
    "e2e:test:shard:transaction-usa:smoke": "npx playwright test --project \"shard:transaction-usa\" --grep \"@Smoke\"",
    "e2e:test:shard:transaction-usa:critical": "npx playwright test --project \"shard:transaction-usa\" --grep \"@Critical\"",

    "e2e:test:shard:transaction-mexico": "npx playwright test --project \"shard:transaction-mexico\"",
    "e2e:test:shard:transaction-mexico:smoke": "npx playwright test --project \"shard:transaction-mexico\" --grep \"@Smoke\"",
    "e2e:test:shard:transaction-mexico:critical": "npx playwright test --project \"shard:transaction-mexico\" --grep \"@Critical\"",

    "e2e:test:shard:refund": "npx playwright test --project \"shard:refund\"",
    "e2e:test:shard:refund:smoke": "npx playwright test --project \"shard:refund\" --grep \"@Smoke\"",
    "e2e:test:shard:refund:critical": "npx playwright test --project \"shard:refund\" --grep \"@Critical\"",

    "e2e:test:shard:vaulting": "npx playwright test --project \"shard:vaulting\"",
    "e2e:test:shard:vaulting:smoke": "npx playwright test --project \"shard:vaulting\" --grep \"@Smoke\"",
    "e2e:test:shard:vaulting:critical": "npx playwright test --project \"shard:vaulting\" --grep \"@Critical\"",

    "e2e:test:shard:subscription": "npx playwright test --project \"shard:subscription\"",
    "e2e:test:shard:subscription:smoke": "npx playwright test --project \"shard:subscription\" --grep \"@Smoke\"",
    "e2e:test:shard:subscription:critical": "npx playwright test --project \"shard:subscription\" --grep \"@Critical\"",

    "e2e:test:stress": "npx playwright test --project \"stress\"",

    "e2e:env:reset": "npx playwright test --project \"setup\" --grep \"env:reset;\"",
    "e2e:env:reset:wc": "npx playwright test --project \"setup\" --grep \"env:reset;|setup:wc;\"",
    "e2e:env:reset:pcp:usa": "npx playwright test --project \"setup\" --grep \"env:reset;|setup:wc;|setup:pcp:usa;\"",
    "e2e:env:reset:pcp:germany": "npx playwright test --project \"setup\" --grep \"env:reset;|setup:wc;|setup:pcp:germany;\"",
    "e2e:env:reset:pcp:mexico": "npx playwright test --project \"setup\" --grep \"env:reset;|setup:wc;|setup:pcp:mexico;\"",

    "e2e:env:setup:wc": "npx playwright test --project \"setup\" --grep \"setup:wc;\"",
    "e2e:env:setup:pcp:usa": "npx playwright test --project \"setup\" --grep \"setup:pcp:usa;\"",
    "e2e:env:setup:pcp:germany": "npx playwright test --project \"setup\" --grep \"setup:pcp:germany;\"",
    "e2e:env:setup:pcp:mexico": "npx playwright test --project \"setup\" --grep \"setup:pcp:mexico;\"",

    "e2e:env:setup:pcp:update": "npx playwright test --project \"setup\" --grep \"setup:pcp:update;\"",
    "e2e:env:setup:checkout:block": "npx playwright test --project \"setup\" --grep \"setup:checkout:block;\"",
    "e2e:env:setup:checkout:classic": "npx playwright test --project \"setup\" --grep \"setup:checkout:classic;\"",
    "e2e:env:setup:tax:inc": "npx playwright test --project \"setup\" --grep \"setup:tax:inc;\"",
    "e2e:env:setup:tax:exc": "npx playwright test --project \"setup\" --grep \"setup:tax:exc;\"",

    "e2e:lint:md:fix": "wp-scripts lint-md-docs --fix ./tests/qa/**/*.md ./E2E-TESTS.md",
    "e2e:lint:js:fix": "wp-scripts lint-js --fix --ext .ts,.tsx,.mjs ./tests/qa"
  },
  "config": {
    "wp_org_slug": "woocommerce-paypal-payments"
  },
  "dependencies": {
    "@paypal/paypal-js": "^8.1.3",
    "@paypal/react-paypal-js": "^8.9.2",
    "classnames": "^2.5.1",
    "core-js": "^3.39",
    "deepmerge": "^4.3",
    "dotenv": "^16.0.3",
    "escape-html": "^1.0.3",
    "formdata-polyfill": "^4.0.10",
    "react": "^18",
    "react-dom": "^18",
    "react-select": "^5.10.2",
    "uuid": "^11"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@inpsyde/playwright-utils": "^5.1.0",
    "@playwright/test": "^1.59.0",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.8.4",
    "@woocommerce/dependency-extraction-webpack-plugin": "^2.2.0",
    "@wordpress/a11y": "^4.40.0",
    "@wordpress/api-fetch": "^7.40.0",
    "@wordpress/block-editor": "^14.21.0",
    "@wordpress/blocks": "^15.13.0",
    "@wordpress/components": "^32.2.0",
    "@wordpress/data": "^10.37.0",
    "@wordpress/data-controls": "^4.37.0",
    "@wordpress/element": "^6.1.0",
    "@wordpress/env": "^10.30.0",
    "@wordpress/i18n": "^6.10.0",
    "@wordpress/icons": "^11.4.0",
    "@wordpress/jest-preset-default": "^12.37.0",
    "@wordpress/notices": "^5.40.0",
    "@wordpress/plugins": "^7.40.0",
    "@wordpress/primitives": "^4.40.0",
    "@wordpress/scripts": "^31.2.0",
    "@wordpress/url": "^4.40.0",
    "babel-plugin-explicit-exports-references": "^1.0.2",
    "eslint-import-resolver-webpack": "^0.13.10",
    "jquery": "^3.7.1"
  }
}
