{
    "permissions": {
        "allow": [
            "Bash(git log:*)",
            "Bash(git diff *)",
            "Bash(git status *)",
            "Read(.claude/notes/**)",
            "Glob(.claude/notes/**)",
            "Grep(.claude/notes/**)",
            "Edit(.claude/notes/**)",
            "Write(.claude/notes/**)"
        ],
        "deny": [],
        "ask": []
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/php-review-track.sh\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/php-review-stop.sh\""
                    }
                ]
            }
        ]
    }
}
