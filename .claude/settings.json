{
    "permissions": {
        "allow": [
            "Bash(git log:*)",
            "Bash(git diff:*)",
            "Bash(git status:*)"
        ],
        "deny": [],
        "ask": []
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/track-edited-php-files.sh\"",
                        "timeout": 30
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/review-edited-php-files.sh\"",
                        "timeout": 600
                    },
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/git-state.sh\" save",
                        "timeout": 10
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/git-state.sh\" check",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
