#!/bin/bash
## Description: Extract the PayPal tracking carriers list into carriers_data.php
## Usage: carriers-extractor
## Example: ddev carriers-extractor

cd /var/www/html || exit 1

if ! node .ddev/bin/carriers-extractor.js; then
	echo "❌ Extraction failed. Please check the error messages above."
	exit 1
fi

echo ""
echo "📄 Generated file: carriers_data.php in the root of the project"
echo ""
echo "⏭️ Next steps:"
echo "1. Copy the array from carriers_data.php into \`modules/ppcp-order-tracking/carriers.php\`"
echo "2. Run \`ddev npm run fix-lint -- modules/ppcp-order-tracking/carriers.php\` to format the file"
echo "3. Run \`ddev npm run unit-tests\` to be sure nothing is broken"
echo "4. Remove the temporary carriers_data.php from the root of the project"
echo "5. Review and commit your changes"
